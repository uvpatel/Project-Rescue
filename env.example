# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/project_rescue"

# Optional Document Database (MongoDB)
MONGODB_URI="mongodb://localhost:27017/project_rescue"
MONGODB_USERNAME=""
MONGODB_PASSWORD=""

# Application Host
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Better Auth
BETTER_AUTH_SECRET="your-high-entropy-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth (User sign-in)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub App Integration (server-only; never prefix these with NEXT_PUBLIC_)
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
# Paste the complete downloaded PEM key. For .env files, encode newlines as \\n.
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# AI Provider Configuration
GEMINI_API_KEY=""
AI_PROVIDER="gemini"
AI_MODEL="gemini-1.5-pro"

# Observability & Logging
LOG_LEVEL="debug"
